# Copie ce fichier en `.streamlit/secrets.toml` (jamais versionné, voir
# .gitignore) puis colle les infos de ton projet Supabase :
# Project Settings > API > Project URL / anon public key.
#
# Sur Streamlit Community Cloud, renseigne les deux mêmes clés dans
# l'interface "Secrets" de l'app plutôt que dans un fichier.

SUPABASE_URL = ""
SUPABASE_ANON_KEY = ""
